# ------------------------------------------------------------------------------
# MeterMind Local Development Environment Template
# Copy this file to .env for local Docker Compose overrides:
#   cp .env.example .env
# ------------------------------------------------------------------------------

# Local MySQL Docker container settings
# (Port 3307 avoids conflicts with native Windows MySQL on 3306)
MYSQL_PORT=3307
MYSQL_DATABASE=metermind
MYSQL_USER=metermind
MYSQL_PASSWORD=metermind_local_secret
MYSQL_ROOT_PASSWORD=root_local_secret

# Optional Spring Boot Datasource overrides
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/metermind?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=metermind
SPRING_DATASOURCE_PASSWORD=metermind_local_secret
